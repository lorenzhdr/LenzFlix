[Unit]
Description=LENZFLIX Server-Statistik melden
After=network-online.target vnstat.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lenzflix/report.env
ExecStart=/usr/local/bin/lenzflix-report.sh
DynamicUser=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
