# Nach /etc/lenzflix/report.env kopieren, Rechte 0600.

# Basis-URL des LENZFLIX-Workers, nur https:// (ohne abschliessenden Schraegstrich).
LFX_URL=https://example.invalid

# Gemeinsames Geheimnis, mindestens 32 Zeichen. Muss dem Secret im Worker entsprechen.
LFX_SECRET=CHANGE_ME_MINDESTENS_32_ZEICHEN_LANG_0000

# Optional: Netzwerk-Schnittstelle fuer vnstat (siehe `vnstat --iflist`).
# Leer lassen = Standard von vnstat.
#LFX_IFACE=eth0

# Optional: Platten als Pfad=Label, getrennt durch Semikolon.
# Labels: Buchstaben, Ziffern, Leerzeichen, _ und -, Umlaute; hoechstens 24 Zeichen.
LFX_DISKS="/=System;/mnt/media=Medien"

# Probelauf: 1 = JSON nur ausgeben, nichts senden (hier normalerweise nicht setzen).
#LFX_DRY=1
