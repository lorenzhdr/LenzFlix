// Öffentliche Vorlage mit Platzhaltern. Für das eigene Deployment: Datei nach wrangler.local.jsonc kopieren
// (gitignored), echte Domains + KV-ID eintragen und mit `npx wrangler deploy -c wrangler.local.jsonc` deployen.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lenzflix-charts",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "triggers": { "crons": ["0 * * * *"] },
  "routes": [{ "pattern": "charts.example.com", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "CHARTS",
      // Platzhalter: ID per `npx wrangler kv namespace create CHARTS` erzeugen und hier eintragen.
      "id": "REPLACE_WITH_KV_ID"
    }
  ],
  "vars": {
    "JELLYFIN_URL": "https://jellyfin.example.com",
    "ALLOWED_ORIGIN": "https://jellyfin.example.com",
    "WINDOW_DAYS": "30",
    "MIN_SECONDS": "300",
    "MP_MAX_CONN": "16",
    "MP_DAILY_REQ": "80000",
    "MP_DEV_ORIGINS": ""
  },
  // Secrets (nicht hier!): JELLYFIN_API_KEY, optional REFRESH_SECRET, MP_SECRET (Mehrspieler, mindestens 32 Zeichen) -> `npx wrangler secret put <NAME>`
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "MpWorld" }] },
  "migrations": [{ "tag": "mp1", "new_sqlite_classes": ["MpWorld"] }],
  "observability": { "enabled": true }
}
